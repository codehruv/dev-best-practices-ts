{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["eslint.config.base.ts"]
    },
    "packages/slo": {
      "entry": ["src/index.ts", "src/cli.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/api-contract": {
      "entry": ["src/index.ts", "src/cli/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "tools/*": {
      "entry": ["src/cli.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true
}
