{
  "name": "dev-best-practices-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript monorepo template with battle-tested engineering practices, linters, agent defaults, and automations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codehruv/dev-best-practices-ts.git"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test:unit",
    "generate": "turbo run generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "changeset": "changeset",
    "release-tools": "turbo run build --filter=@dbp/release-tools --output-logs=errors-only && node tools/release/dist/cli.js",
    "version-packages": "pnpm run release-tools changelog && changeset version && pnpm run generate && prettier --write --log-level warn \"**/CHANGELOG.md\" \"**/package.json\"",
    "docs:check": "turbo run docs:check",
    "bench": "pnpm --recursive --workspace-concurrency=1 --if-present run bench",
    "slo": "turbo run build --filter=@dbp/slo --output-logs=errors-only && node packages/slo/dist/cli.js"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "jiti": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
