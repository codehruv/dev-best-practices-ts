{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just verify)",
      "Bash(just fix)",
      "Bash(just test)",
      "Bash(just lint)",
      "Bash(just typecheck)",
      "Bash(just fmt)",
      "Bash(just legacy-validate)",
      "Bash(just legacy-update)",
      "Bash(just --list)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(just fmt-file:*)",
      "Bash(just generate)",
      "Bash(pnpm run:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm ls:*)",
      "Bash(just api-check)",
      "Bash(just changesets)",
      "Bash(just changeset)",
      "Bash(just docs-check)",
      "Bash(just bench)",
      "Bash(just slo)",
      "Bash(just slo-validate)",
      "Bash(pnpm changeset status:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pnpm exec legacy-lint-manager legacy-errors:*)",
      "Bash(npx legacy-lint-manager legacy-errors:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited-file.sh"
          }
        ]
      }
    ]
  }
}
