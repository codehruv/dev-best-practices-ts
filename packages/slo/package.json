{
  "name": "@dbp/slo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Validates OpenSLO specs and checks benchmark-backed SLOs against their objectives and baselines.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "slo": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
