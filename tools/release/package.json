{
  "name": "@dbp/release-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Release automation: Keep a Changelog writer and interface breaking-change checks.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@changesets/get-release-plan": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
